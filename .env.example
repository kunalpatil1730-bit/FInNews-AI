# GROQ_API_KEY: Required for Groq API (LLaMA 3.3-70B Versatile)
# Obtain your key from https://console.groq.com
GROQ_API_KEY=""

# GROQ_MODEL: Default is LLaMA 3.3-70B Versatile
GROQ_MODEL="llama-3.3-70b-versatile"

# Optional: NewsAPI Key (https://newsapi.org)
# If omitted, FinNews AI automatically fetches live real-time financial news from Google News RSS feeds!
NEWS_API_KEY=""

# Optional: Finnhub API Key (https://finnhub.io) for institutional market feeds
FINNHUB_API_KEY=""

# Optional: Gemini API Key
GEMINI_API_KEY=""

# Host & Port Settings
HOST="0.0.0.0"
PORT=8000

# Frontend API URL configuration (for production / Firebase deployment)
# Leave empty for local development to use relative proxy
VITE_API_BASE_URL=""
VITE_PRODUCTION_API_URL="https://finnews-ai-backend.onrender.com"
